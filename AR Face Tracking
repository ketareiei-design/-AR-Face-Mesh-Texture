<a-scene mindar-face embedded vr-mode-ui="enabled: false" device-orientation-permission-ui="enabled: false">
  <a-assets>
    <!-- ลิงก์ไฟล์ GLB ที่โฮสต์บน GitHub ผ่าน jsDelivr -->
    <a-asset-item id="customGlasses" src="https://cdn.jsdelivr.net/gh/john-doe/my-ar-assets/my-glasses.glb"></a-asset-item>
  </a-assets>

  <!-- แสดงผลโมเดลที่ตำแหน่งสันจมูก/ระหว่างคิ้ว (Anchor 168) -->
  <a-entity mindar-face-target="anchorIndex: 168">
    <a-gltf-model src="#customGlasses" position="0 0 0" scale="0.1 0.1 0.1" rotation="0 0 0"></a-gltf-model>
  </a-entity>
</a-scene>
